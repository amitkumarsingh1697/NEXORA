{
  "name": "@nexora/brain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "3D architecture brain: data model, region classification, three.js viewer and single-file HTML renderer shared by CodeAtlas and ArchLens.",
  "exports": {
    ".": "./src/index.ts",
    "./viewer": "./src/viewer.ts",
    "./template": "./template/brain-template.html"
  },
  "scripts": {
    "build": "vite build && node scripts/make-template.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "vite": "8.3.5"
  }
}
