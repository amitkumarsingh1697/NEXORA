# CodeAtlas local service. Binds to 127.0.0.1 only.
# The service reads its environment directly (it does not load .env files): export these in your shell.
# Defaults to ~/.codeatlas (use an absolute path; ~ is not expanded).
# CODEATLAS_HOME=
CODEATLAS_PORT=4317
# Comma-separated directories repositories may be registered from (empty = any local path).
CODEATLAS_ALLOWED_ROOTS=
# CODEATLAS_WEB_DIR=
# CODEATLAS_WORKTREE_DIR=
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Source code is never sent to a hosted model unless both are set.
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=
AI_REMOTE_CONSENT=false
