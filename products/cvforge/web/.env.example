# CVForge web + API. Copy to .env.local (never commit real values).
# All values below are local-development defaults.
NODE_ENV=development
DATABASE_URL=postgres://nexora:nexora_dev@127.0.0.1:5432/cvforge
# Required in production: at least 32 random characters, e.g. `openssl rand -hex 32`.
APP_SECRET=
APP_ORIGIN=http://localhost:3000
STORAGE_DIR=.data/storage
MAIL_OUTBOX_DIR=.data/outbox
# PDF export uses LibreOffice; set if soffice is not on PATH.
# SOFFICE_PATH=
SESSION_TTL_DAYS=14
EXTENSION_ACCESS_TTL_SECONDS=900
EXTENSION_REFRESH_TTL_DAYS=30
EXPORT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# AI suggestions. Default is a local Ollama model; "disabled" keeps every
# deterministic feature working and turns AI suggestions off.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
AI_CONTEXT_TOKENS=8192
AI_TIMEOUT_MS=120000
# A hosted OpenAI-compatible endpoint (paid, sends resume text off-device) is
# used only if configured AND AI_REMOTE_CONSENT=true.
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=
AI_REMOTE_CONSENT=false
