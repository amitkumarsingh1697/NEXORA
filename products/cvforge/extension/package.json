{
  "name": "@nexora/cvforge-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CVForge browser extension (Chrome/Edge, Manifest V3) for user-initiated job description capture.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.3",
    "@types/jsdom": "21.1.7",
    "wxt": "0.21.5"
  }
}
